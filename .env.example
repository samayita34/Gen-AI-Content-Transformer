# ==========================================
# TransformAI System Environment Variables
# ==========================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transformai
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM & Multi-Format Generation
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=300

# Multimodal Ingestion (Milestone 5)
OCR_PROVIDER=mock
OCR_MODEL=gemini-2.5-flash
OCR_TIMEOUT_SECONDS=60
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_MODEL=gemini-2.5-flash
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Verification Agent (Milestone 6)
VERIFICATION_PROVIDER=mock
VERIFICATION_MODEL=gemini-2.5-flash
VERIFICATION_TEMPERATURE=0.0
VERIFICATION_TOP_K=3
VERIFICATION_SIMILARITY_THRESHOLD=0.2
VERIFICATION_TIMEOUT_SECONDS=60


